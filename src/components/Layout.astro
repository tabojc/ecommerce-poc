---
import { getCart } from '../lib/cart';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cloudflare PoC — E-commerce listo para white-label</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
  <nav class="bg-white border-b border-gray-200">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-brand-600">☁️ CloudStore</a>
      <div class="space-x-6">
        <a href="/shop" class="text-gray-600 hover:text-brand-600 font-medium">Catálogo</a>
        <a href="/cart" class="text-gray-600 hover:text-brand-600 font-medium relative">
          Carrito
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center" id="cart-count">0</span>
        </a>
      </div>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer class="bg-gray-100 border-t border-gray-200 mt-12">
    <div class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h4 class="font-bold mb-4">Tienda</h4>
        <div class="space-y-2 text-sm text-gray-600">
          <a href="/shop" class="hover:text-brand-600">Catálogo</a>
          <a href="/checkout" class="hover:text-brand-600">Checkout</a>
        </div>
      </div>
      <div>
        <h4 class="font-bold mb-4">Compañía</h4>
        <div class="space-y-2 text-sm text-gray-600">
          <a href="/" class="hover:text-brand-600">Inicio</a>
          <a href="/shop" class="hover:text-brand-600">Menú</a>
        </div>
      </div>
      <div>
        <h4 class="font-bold mb-4">Legal</h4>
        <div class="space-y-2 text-sm text-gray-600">
          <a href="/" class="hover:text-brand-600">Privacidad</a>
          <a href="/" class="hover:text-brand-600">Términos</a>
        </div>
      </div>
      <div>
        <h4 class="font-bold mb-4">Contacto</h4>
        <div class="space-y-2 text-sm text-gray-600">
          <a href="mailto:hola@cloudstore.com" class="hover:text-brand-600">hola@cloudstore.com</a>
          <a href="tel:+123456789" class="hover:text-brand-600">+1 234 567 890</a>
        </div>
      </div>
    </div>
    <div class="container mx-auto px-4 py-6 text-center text-gray-500 text-sm border-t border-gray-200">
      <p>Cloudflare PoC — D1 + R2 + Astro</p>
    </div>
  </footer>
</body>
</html>