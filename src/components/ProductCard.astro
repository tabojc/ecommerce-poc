---
interface Props {
  product: {
    id: number;
    name: string;
    description?: string | null;
    price: number;
    image_url?: string | null;
    category?: string | null;
    stock?: number;
  };
  addToCart?: (productId: number, quantity?: number) => void;
}

const { product, addToCart } = Astro.props;

const formattedPrice = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  minimumFractionDigits: 2,
}).format(product.price / 100);
---

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-200 group">
  <div class="relative aspect-square bg-gray-100 overflow-hidden">
    <img 
      src={product.image_url || 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" fill="none"><rect width="300" height="300" fill="%23e5e7eb"/><text x="50%" y="50%" font-family="sans-serif" font-size="16" fill="%239ca3af" dominant-baseline="middle" text-anchor="middle">Sin imagen</text></svg>'} 
      alt={product.name} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
    {product.category && (
      <span class="absolute top-2 left-2 bg-brand-600 text-white text-xs px-2 py-1 rounded">{product.category}</span>
    )}
  </div>
  <div class="p-4">
    <h3 class="text-lg font-bold text-gray-900 mb-1">{product.name}</h3>
    <p class="text-gray-500 text-sm mb-3 line-clamp-2">{product.description || ''}</p>
    <div class="flex justify-between items-center">
      <span class="text-xl font-bold text-brand-600">{formattedPrice}</span>
      {product.stock === 0 ? (
        <span class="text-red-500 text-xs font-bold uppercase">Sin stock</span>
      ) : (
        <button 
          type="button"
          class="bg-brand-600 hover:bg-brand-700 text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors"
          data-add-to-cart={product.id}
        >
          Agregar
        </button>
      )}
    </div>
  </div>
</div>