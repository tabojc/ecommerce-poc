---
import Layout from '../components/Layout.astro';

const stats = [
  { value: '5+', label: 'Años de cocina' },
  { value: '4.8', label: 'Rating promedio' },
  { value: '2.3k', label: 'Pedidos mensuales' },
  { value: '98%', label: 'Satisfacción' },
];

const testimonials = [
  {
    quote: 'La mejor pizza de la ciudad, y la pedimos online sin problemas.',
    name: 'María González',
    role: 'Cliente frecuente',
  },
  {
    quote: 'El pedido llegó rápido y la pizza estaba caliente. Excelente.',
    name: 'Carlos Pérez',
    role: 'Cliente',
  },
];
---

<div class="container mx-auto px-4 py-8">
  <Layout>
    <!-- Sección 1: Hero con fondo (video placeholder / gradiente caoba) -->
    <section class="relative min-h-[70vh] flex items-center justify-center bg-amber-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-900/90 via-amber-900/80 to-amber-900"></div>
      <div class="relative z-10 max-w-3xl mx-auto px-4 py-20 text-center">
        <p class="uppercase tracking-widest text-amber-200 text-sm font-semibold mb-6">Restaurante &amp; delivery</p>
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Tu comida favorita, en tu mesa.</h1>
        <p class="text-lg md:text-xl text-amber-100 mb-8">Pedidos online, pagos y control desde la web.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/shop" class="bg-white text-amber-900 hover:bg-amber-100 px-8 py-4 rounded-xl font-bold text-lg transition-colors">Ver menú</a>
          <a href="/checkout" class="border-2 border-white text-white hover:bg-white hover:text-amber-900 px-8 py-4 rounded-xl font-bold text-lg transition-colors">Ir al checkout</a>
        </div>
      </div>
    </section>

    <!-- Sección 2: Imagen + descripción -->
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
        <div class="rounded-2xl bg-gray-200 h-[420px]"></div>
        <div>
          <p class="text-amber-700 font-semibold uppercase tracking-wider text-sm">Menú</p>
          <h2 class="text-4xl font-bold mt-2 mb-4">Plato de la casa</h2>
          <p class="text-gray-600 mb-6">La receta que hizo famosa a la casa. Ingredientes frescos, preparación artesanal.</p>
          <div class="text-3xl font-bold text-brand-600 mb-6">$19.99</div>
          <a href="/shop" class="bg-brand-600 text-white px-6 py-3 rounded hover:bg-brand-700 transition-colors">Agregar al carrito</a>
        </div>
      </div>
    </section>

    <!-- Sección 3: Stats -->
    <section class="py-16 bg-amber-900 text-white">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div class="p-4 bg-white/10 rounded-lg text-center">
            <h3 class="text-4xl font-bold mb-2">{s.value}</h3>
            <p class="text-sm text-amber-100">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sección 4: Testimonios -->
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <div class="p-6 bg-white border border-gray-100 rounded-xl">
            <p class="text-gray-700 mb-6">"{t.quote}"</p>
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center font-bold">{(t.name || '').charAt(0)}</div>
              <div>
                <p class="font-bold">{t.name}</p>
                <p class="text-sm text-gray-500">{t.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </Layout>
</div>
