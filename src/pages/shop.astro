---
import { getCart } from '../lib/cart';
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = await fetch('/api/products').then(res => res.json());
const cart = getCart();
---

<div class="container mx-auto px-4 py-8">
  <Layout>
    <div class="bg-white">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-brand-600">Nuestro Catálogo</h1>
        <div class="space-x-4">
          <a href="/" class="text-gray-500 hover:text-gray-700">Inicio</a>
          <a href="/cart" class="text-gray-500 hover:text-gray-700">Carrito (<span class="text-red-600 font-bold" x-text="cart.length"></span>)</a>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
      
      <div class="mt-8">
        <h2 class="text-xl font-bold mb-4">Carrito (<span class="text-red-600" x-text="cart.length"></span>)</h2>
        <div class="border-t border-gray-200 pt-4">
          {cart.length === 0 ? (
            <p class="text-gray-500">Tu carrito está vacío</p>
          ) : (
            <div class="space-y-4">
              {cart.map(item => (
                <div key={item.productId} class="flex justify-between">
                  <span class="text-gray-700">{item.quantity}x</span>
                  <button 
                    class="text-red-600 hover:text-red-700"
                    data-remove-from-cart={item.productId}
                  >
                    Eliminar
                  </button>
                </div>
              ))}
              <div class="mt-4">
                <p class="text-xl font-bold">Total: ${cart.length} productos</p>
                <button 
                  class="bg-brand-600 text-white px-6 py-3 rounded hover:bg-brand-700 transition-colors"
                  data-checkout
                >
                  Proceder al Pago
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </Layout>
</div>

<script>
  // Simple cart total calculation
  function cartTotal() {
    let total = 0;
    // TODO: implement actual cart total calculation
    return Math.round(total);
  }
</script>